{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.42/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 8,
  "default_container_padding": 6,
  "border": true,
  "border_width": 4,
  "border_offset": -1,
  "border_style": "Rounded",
  "border_implementation": "Komorebi",
  "mouse_follows_focus": false,
  "ignore_rules": [
    {
      "kind": "Exe",
      "id": "yasb.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Rainmeter.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "folder_menu.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "hotkey_cheatsheet.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "audio_visualizer.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "scratchpad.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "live_wallpaper.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "wallpaper_gallery.exe",
      "matching_strategy": "Equals"
    }
  ],
  "animation": {
    "enabled": true,
    "duration": 200,
    "fps": 60,
    "style": "EaseOutCubic",
    "ghost_movement": true
  },
  "theme": {
    "palette": "Catppuccin",
    "name": "Mocha",
    "single_border": "Pink",
    "stack_border": "Sky",
    "monocle_border": "Mauve",
    "floating_border": "Yellow",
    "unfocused_border": "Surface1"
  },
  "monitors": [
    {
      "workspaces": [
        { "name": "1", "layout": "BSP", "tile": true },
        { "name": "2", "layout": "BSP", "tile": true },
        { "name": "3", "layout": "BSP", "tile": true },
        { "name": "4", "layout": "BSP", "tile": true },
        { "name": "5", "layout": "BSP", "tile": true },
        { "name": "6", "layout": "BSP", "tile": true },
        { "name": "7", "layout": "BSP", "tile": true },
        { "name": "8", "layout": "BSP", "tile": true }
      ]
    }
  ]
}
